PRISM_ENV=development
PRISM_DATABASE_URL=postgresql+asyncpg://prism:prism@postgres:5432/prism
PRISM_ALEMBIC_DATABASE_URL=postgresql+psycopg://prism:prism@postgres:5432/prism
PRISM_REDIS_URL=redis://redis:6379/0
PRISM_GITHUB_TOKEN=
PRISM_GITHUB_APP_ID=
PRISM_GITHUB_WEBHOOK_SECRET=
PRISM_GITHUB_PRIVATE_KEY_PATH=
PRISM_API_KEY=
PRISM_RATE_LIMIT_PER_MINUTE=30
PRISM_AUTHORIZED_REPOSITORIES=
PRISM_GROQ_API_KEY=
PRISM_GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
PRISM_GROQ_MODEL=llama-3.3-70b-versatile
PRISM_GEMINI_API_KEY=
PRISM_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
PRISM_GEMINI_MODEL=gemini-2.0-flash
PRISM_AI_TIMEOUT_SECONDS=30
PRISM_AI_MAX_RETRIES=2
PRISM_ALLOW_PRIVATE_AI=false
PRISM_CORS_ORIGINS=http://localhost:5173
